<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- WebSocket 中转服务器地址 -->
        <add key="WebSocketUrl" value="ws://192.168.16.61:3000" />
        <!-- 文件服务器地址 -->
        <add key="FileServerUrl" value="http://192.168.16.61:3001" />
        <add key="TtsServerUrl" value="http://192.168.16.61:3001" />
        <add key="TtsVoice" value="xiaoxiao" />
        <!-- 本地媒体缓存目录 -->
        <add key="MediaPath" value="C:\media" />
        <!-- Office PPT 服务地址（备用，PPT 控制已改用 Interop） -->
        <add key="PPTApiUrl" value="http://127.0.0.1:20165/api" />
        <!-- 固定屏幕序号，0 表示由服务端自动分配 -->
        <add key="ScreenNumber" value="0" />
    </appSettings>
</configuration>

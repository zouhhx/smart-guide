<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="@color/panel_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/panel_stroke" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/panel_surface_deep"
                android:startColor="@color/panel_surface_glow" />
        </shape>
    </item>
</layer-list>

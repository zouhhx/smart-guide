<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#D8EBFF" />
        </shape>
    </item>
    <item android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="#B7D8FF" />
        </shape>
    </item>
    <item android:left="32dp" android:top="32dp" android:right="32dp" android:bottom="32dp">
        <shape android:shape="oval">
            <gradient android:angle="90" android:startColor="#3795FF" android:endColor="#0865CF" />
            <stroke android:width="3dp" android:color="#80BFFF" />
        </shape>
    </item>
</layer-list>

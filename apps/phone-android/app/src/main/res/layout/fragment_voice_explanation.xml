<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v27_page_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@color/v27_header_navy"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_explanation_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/settings"
            android:padding="13dp"
            android:src="@drawable/ic_settings_gear"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.codexpro.asrapk.gesture.GestureSurfaceLayout
        android:id="@+id/gestureSurface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        app:layout_constraintBottom_toTopOf="@id/talkArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/targetCard"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="15dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/v27_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="17dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/current_target_label"
                        android:textColor="@color/v27_text_secondary"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/targetTypeIcon"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_screen_blue" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:background="@drawable/bg_target_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/targetName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textColor="@color/v27_blue"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/targetState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:textSize="11sp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/lockState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/target_locked_badge"
                                android:textColor="@color/v27_blue"
                                android:textSize="11sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <View
                            android:id="@+id/targetStatusDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_status_dot_gray" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/changeTargetButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/change_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/v27_chevron" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="166dp"
                android:layout_marginTop="15dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="15dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/v27_card_stroke"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="18dp"
                    android:paddingTop="15dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/recognitionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_recognition"
                        android:textColor="@color/v27_text_primary"
                        android:textSize="15sp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/recognitionWaveIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wave_blue"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/recognitionText"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="3"
                        android:textColor="@color/v27_text_primary"
                        android:textSize="19sp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/cardDivider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="@color/v27_divider"
                        android:visibility="gone"
                        app:layout_constraintBottom_toTopOf="@id/statusRow"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:id="@+id/statusRow"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <View
                            android:id="@+id/operationStatusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_status_dot_blue" />

                        <TextView
                            android:id="@+id/operationStatus"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:textColor="@color/v27_blue"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <View
                            android:id="@+id/phoneNetworkDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="18dp"
                            android:background="@drawable/bg_status_dot_gray" />

                        <TextView
                            android:id="@+id/phoneNetworkStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/v27_text_tertiary"
                            android:textSize="10sp"
                            android:visibility="gone" />

                        <View
                            android:id="@+id/coreStatusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="18dp"
                            android:background="@drawable/bg_status_dot_gray" />

                        <TextView
                            android:id="@+id/coreStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:textColor="@color/v27_text_tertiary"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.codexpro.asrapk.gesture.GestureSurfaceLayout>

    <com.codexpro.asrapk.gesture.PressToTalkLayout
        android:id="@+id/talkArea"
        android:layout_width="224dp"
        android:layout_height="224dp"
        android:layout_marginBottom="34dp"
        android:background="@drawable/bg_v27_mic_idle"
        android:clickable="true"
        android:contentDescription="@string/press_to_talk"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.codexpro.asrapk.AudioWaveView
            android:id="@+id/waveView"
            android:layout_width="128dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="49dp"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="24dp">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:contentDescription="@string/press_to_talk"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/microphoneLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="@string/press_to_talk"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dynamicCancelHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.codexpro.asrapk.gesture.PressToTalkLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/robotPresentation"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/bg_welcome" android:scaleType="centerCrop"
            android:importantForAccessibility="no" />
        <TextureView android:id="@+id/robotSpeakingVideo" android:layout_width="match_parent"
            android:layout_height="match_parent" android:importantForAccessibility="no" />
        <View android:id="@+id/developerAccessZone" android:layout_width="64dp"
            android:layout_height="56dp" android:layout_gravity="top|end"
            android:clickable="true" android:focusable="true"
            android:contentDescription="长按两秒打开设置" />
            <LinearLayout android:id="@+id/robotTeachingPanel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_gravity="top"
                android:layout_marginTop="64dp" android:layout_marginHorizontal="16dp"
                android:paddingHorizontal="12dp" android:paddingVertical="6dp"
                android:background="@drawable/overlay_panel" android:gravity="center_vertical"
                android:visibility="gone">
                <ScrollView android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:fillViewport="true">
                    <TextView android:id="@+id/robotTeachingStatus" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:gravity="center_vertical"
                        android:textColor="#FFFFFF" android:textSize="11sp" android:lineSpacingExtra="2dp" />
                </ScrollView>
                <Button android:id="@+id/robotFinishTeaching" android:layout_width="100dp"
                    android:layout_height="40dp" android:layout_marginStart="8dp" android:minHeight="0dp"
                    android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
                    android:text="结束教学" android:textSize="12sp" android:textAllCaps="false"
                    android:textColor="#342153" android:backgroundTint="#E6D9FF" />
                <Button android:id="@+id/robotCancelTeaching" android:layout_width="56dp"
                    android:layout_height="40dp" android:layout_marginStart="5dp" android:minWidth="0dp"
                    android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
                    android:text="取消" android:textSize="11sp" android:textAllCaps="false"
                    android:textColor="#FFFFFF" android:backgroundTint="#594777" />
            </LinearLayout>
        <LinearLayout android:id="@+id/robotOverlayStack" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp"
            android:orientation="vertical">
            <LinearLayout android:id="@+id/robotCaptionPanel" android:layout_width="match_parent"
                android:layout_height="100dp" android:orientation="vertical"
                android:background="@drawable/overlay_panel" android:paddingHorizontal="14dp"
                android:paddingVertical="9dp" android:visibility="gone">
                <TextView android:id="@+id/robotQuestionText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                    android:textColor="#D5C7F3" android:textSize="11sp" android:lineSpacingExtra="2dp" />
                <TextView android:id="@+id/robotAnswerLabel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:text="小豹" android:textColor="#D5C7F3" android:textSize="8sp" />
                <ScrollView android:id="@+id/robotAnswerScroll" android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
                    <TextView android:id="@+id/robotAnswerText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="#FFFFFF"
                        android:textSize="16sp" android:lineSpacingExtra="3dp" />
                </ScrollView>
            </LinearLayout>
            <TextView android:id="@+id/robotIdleHint" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                android:background="@drawable/overlay_badge" android:paddingHorizontal="20dp"
                android:paddingVertical="8dp" android:text="说「小豹小豹」，我在听"
                android:textColor="#493277" android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
    <include android:id="@+id/developerPanel" layout="@layout/activity_debug"
        android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
</FrameLayout>

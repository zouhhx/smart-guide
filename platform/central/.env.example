# Platform runtime configuration

# Relay WebSocket service
PORT=3000

# Static media file service
FILE_PORT=3001

# LAN address reachable by phones and display clients
PUBLIC_HOST=192.168.20.158
PUBLIC_WS_URL=ws://192.168.20.158:3000
PUBLIC_FILE_BASE_URL=http://192.168.20.158:3001

# On-demand PowerPoint page thumbnail service
PPT_THUMBNAIL_SERVICE_URL=http://127.0.0.1:3025
PPT_THUMBNAIL_SERVICE_TIMEOUT_MS=15000

# Media directories
MEDIA_DIR=./media
MEDIA_WIN_PATH=\\wsl.localhost\Ubuntu\home\user\.openclaw\workspace\exhibition-hall\media

# Runtime data: usage logs and statistics
DATA_DIR=./data

# ChromaDB vector knowledge search
VECTOR_SEARCH_ENABLED=true
VECTOR_SEARCH_URL=http://127.0.0.1:3021
VECTOR_SEARCH_TIMEOUT_MS=2500
VECTOR_FAQ_MIN_SIMILARITY=0.72
VECTOR_RAG_MIN_SIMILARITY=0.58
VECTOR_MEDIA_MIN_SIMILARITY=0.50
VECTOR_PORT=3021
VECTOR_DB_DIR=./data/chroma
VECTOR_EMBEDDING_PROVIDER=hash
VECTOR_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# TTS fallback: used only when digital-human speech is disabled.
TTS_PROVIDER=iflytek
TTS_VOICE=xiaoyan
TTS_CACHE_DIR=./data/tts-cache
TTS_MAX_TEXT_LENGTH=2000
TTS_SERVICE_URL=http://127.0.0.1:3011/tts
TTS_TIMEOUT_MS=20000
TTS_RETRIES=2

# MoFa digital-human speech bridge
AVATAR_SERVICE_URL=http://127.0.0.1:19200
AVATAR_SERVICE_TIMEOUT_MS=8000
AVATAR_CONTROL_TASK_NAME=ExhibitionMofaAvatarService

# Formal management UI bootstrap account (username: admin). Change before production use.
ADMIN_DEFAULT_PASSWORD=admin123456

# iFlytek online TTS fallback
IFLYTEK_APP_ID=replace-with-iflytek-app-id
IFLYTEK_API_KEY=replace-with-iflytek-api-key
IFLYTEK_API_SECRET=replace-with-iflytek-api-secret
IFLYTEK_TTS_VOICE=xiaoyan
IFLYTEK_TTS_AUE=lame
IFLYTEK_TTS_AUF=audio/L16;rate=16000

# OpenClaw gateway
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=replace-with-openclaw-token
OPENCLAW_AGENT_ID=main
# V5 机器人教学接口凭据。生产环境必须使用独立强随机值，禁止提交真实 Token。
ROBOT_TEACHING_TOKEN=
